#!KAMAILIO
# Bare-minimum dispatcher. No SBC allowlisting, no RPC control, no metrics -
# just enough to route a call. net1/eth0 IPs are substituted in by
# entrypoint.sh at startup. Media is anchored directly between the SBC and
# FreeSWITCH's own net1 address (see ADR 002) - Kamailio is SIP-only and
# never touches RTP or SDP.
#
# topos (ADR 003) hides FreeSWITCH's and Kamailio's real addresses from
# Record-Route/Via/Contact, using topos_htable (in-memory, no DB/Redis -
# see ADR 003's decision) as the mapping store. It needs no route-script
# calls beyond the record_route() already below; it rewrites headers via
# its own callbacks on every relayed request/reply. Tradeoff accepted:
# mappings are per-instance (not shared Kamailio A/B) and don't survive a
# restart - fine, since they only need to live for one call's duration.

debug=2
log_stderror=yes
fork=yes
children=2
tcp_accept_no_cl=yes

listen=udp:__NET1_IP__:5060
listen=udp:__ETH0_IP__:5060
# JSON-RPC over HTTP, eth0 only - never reachable from the SBC side. This is
# how a drain marks this instance's dispatcher entries inactive/active; see
# event_route[xhttp:request] below.
listen=tcp:__ETH0_IP__:8080

loadmodule "tm.so"
loadmodule "sl.so"
loadmodule "rr.so"
loadmodule "pv.so"
loadmodule "maxfwd.so"
loadmodule "textops.so"
loadmodule "siputils.so"
loadmodule "dispatcher.so"
loadmodule "xhttp.so"
loadmodule "jsonrpcs.so"
loadmodule "htable.so"
loadmodule "topos.so"
loadmodule "topos_htable.so"

modparam("jsonrpcs", "transport", 1)

modparam("topos", "storage", "htable")
# dmqreplicate=0: no dmq module loaded - mappings stay local to this
# Kamailio instance, which is the accepted tradeoff for topos_htable
# (see ADR 003). autoexpire covers a stuck/abandoned dialog; cleanup
# otherwise follows the call's own BYE.
modparam("topos_htable", "topos_htable_dialog", "topos_dialog=>size=4;autoexpire=7200;dmqreplicate=0")
modparam("topos_htable", "topos_htable_transaction", "topos_transaction=>size=4;autoexpire=7200")

event_route[xhttp:request] {
	if ($hu =~ "^/RPC") {
		jsonrpc_dispatch();
	} else {
		xhttp_reply("404", "Not Found", "text/plain", "");
	}
	exit;
}

request_route {
	if (!mf_process_maxfwd_header("10")) {
		sl_send_reply("483", "Too Many Hops");
		exit;
	}

	if (is_method("OPTIONS") && uri == myself) {
		sl_send_reply("200", "OK");
		exit;
	}

	# Kamailio doesn't pick the outbound socket by destination reachability -
	# with two listen addresses it relays out whichever one it feels like,
	# which breaks replies when that happens to be net1 for an
	# internal-bound request (FreeSWITCH can't route back to a voice-VLAN
	# address). force_send_socket() makes this explicit both ways.
	if (has_totag()) {
		if (loose_route()) {
			if ($Ri == "__NET1_IP__") {
				force_send_socket(udp:__ETH0_IP__:5060);
			} else {
				force_send_socket(udp:__NET1_IP__:5060);
			}
			route(RELAY);
		} else if (is_method("ACK")) {
			exit;
		} else {
			sl_send_reply("404", "Not here");
		}
		exit;
	}

	if (is_method("INVITE")) {
		record_route();
		if (!ds_select_dst("1", "4")) {
			sl_send_reply("503", "No destination");
			exit;
		}
		force_send_socket(udp:__ETH0_IP__:5060);
		route(RELAY);
		exit;
	}

	sl_send_reply("404", "Not Found");
}

route[RELAY] {
	if (!t_relay()) {
		sl_send_reply("500", "Relay failed");
	}
	exit;
}
